# scripts/ is ignored by default (mostly one-off analysis scripts), but these
# are real application dependencies -- dashboard/dedup.py imports them, and
# the production Docker image needs them (see .dockerignore).
!scripts/
scripts/*
!scripts/hash_and_embed_report_true.py
!scripts/ocr_layout_common.py
!scripts/__init__.py

# tessdata_best/: Tesseract's high-accuracy OCR models, a real runtime
# dependency of dashboard/dedup.py (and scripts/hash_and_embed_report_true.py)
# -- not a dev-scratch directory despite living next to ones that are.
!tessdata_best/