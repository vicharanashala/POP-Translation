# scripts/ is ignored by default (mostly one-off analysis scripts). These are
# kept by name: run_pop_to_docx_updated_pagewise_docx.py is the translation
# pipeline the server imports, sync_lgd.py is the vocabulary sync, and the two
# corpus scripts are the hand-run Tesseract + embedding tooling (the
# `corpus-tools` extra in pyproject.toml; kept out of the Docker image by
# .dockerignore -- no server code imports them).
!scripts/
scripts/*
!scripts/hash_and_embed_report_true.py
!scripts/ocr_layout_common.py
!scripts/run_pop_to_docx_updated_pagewise_docx.py
!scripts/sync_lgd.py
!scripts/__init__.py
# Node dashboard backend
node_modules/
server/package-lock.json
