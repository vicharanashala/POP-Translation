# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/

# Virtual environment
venv/
# .venv/ is THE one that matters here: this repo's virtualenv is 2.8 GB, and
# without this line `COPY . .` carried all of it -- a 2.94 GB layer rewritten on
# every rebuild, for files the image cannot use anyway (it installs its own
# dependencies from requirements.lock into system site-packages, and the host
# venv's binaries and absolute paths are wrong inside the container).
.venv/

# Runtime data (mounted as Docker volumes in production)
pop-data/
POP_Work/
outputs/
Data/
Workdir/

# Dev / notebook artifacts
.ipynb_checkpoints/
*.ipynb

# Secrets / local config
.env
.env.*

# Logs / temp
*.log
*.tmp
*.bak

# Type checkers & linters
.mypy_cache/
.ruff_cache/
.pytype/

# Tests
.pytest_cache/
.coverage
htmlcov/

# OS metadata
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Git
.git/
.github/

