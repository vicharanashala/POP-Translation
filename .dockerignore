# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/

# Virtual environment
venv/
# .venv/ is THE one that matters here: this repo's virtualenv is 2.8 GB, and
# without this line `COPY . .` carried all of it -- a 2.94 GB layer rewritten on
# every rebuild, for files the image cannot use anyway (it installs its own
# dependencies from requirements.lock into system site-packages, and the host
# venv's binaries and absolute paths are wrong inside the container).
.venv/

# Runtime data (mounted as Docker volumes in production)
pop-data/
POP_Work/
outputs/
Data/
Workdir/

# Dev / notebook artifacts
.ipynb_checkpoints/
*.ipynb

# Secrets / local config
.env
.env.*

# Logs / temp
*.log
*.tmp
*.bak

# Type checkers & linters
.mypy_cache/
.ruff_cache/
.pytype/

# Tests
.pytest_cache/
.coverage
htmlcov/

# OS metadata
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Git
.git/
.github/

# Claude / planning docs
.claude/
CLAUDE.md
ZOHO_MIGRATION_AGENT_PLAN.txt
ZOHO_WORKDRIVE_AGENT_PLAN.md
containerization_audit_prompt.md
prompt.md
pop_translation.md
pop_translation_doc.md
README.md


# Dedup artefacts: fix/*.py MUST ship (dashboard/chunk_store.py imports
# fix/chunkmatch.py), but fix/out/ is 248 MB of vectors and fix/backup/ is a
# database dump -- both are mounted at runtime, not baked in.
fix/out/
fix/backup/

# local dev
claude_api_compare/
claude_compare/
cropped_files/
cropped_files_2/
cropped_files_3/
gemini_compare/
gpt_compare/
results/
tmp/
tmp_2/

# scripts/ ships, because scripts/run_pop_to_docx_updated_pagewise_docx.py IS the
# translation pipeline. These two do not: they are the hand-run corpus tooling
# (Tesseract + sentence-transformers, installed by the `corpus-tools` extra in
# pyproject.toml, not by this image), so inside the container they could only
# fail on import. Nothing the server loads reaches them.
scripts/hash_and_embed_report_true.py
scripts/ocr_layout_common.py

# Nothing the server reads at runtime: docs and tests are for people, and the
# rest are one-off exports, working files and office documents that sit in the
# checkout (some hold credentials) and would otherwise be copied by `COPY . .`
# on a local `docker compose up --build`.
docs/
tests/
anara/
exports/
logs/
*.odt
*.ods
*.xlsx
*.docx
*.pdf
*.csv

